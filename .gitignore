# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Native build artifacts
*.so
*.pyd
*.dll

# Virtual environments
venv/
.venv/
env/
.env/

# Packaging and build outputs
build/
dist/
*.egg-info/

# Test, coverage, and lint caches
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.ruff_cache/
.mypy_cache/
.tox/

# Jupyter Notebook
.ipynb_checkpoints/
notebooks/.ipynb_checkpoints/
notebooks/_notebook_outputs/
notebooks/result_notebook/

# Logs and temporary files
*.log
*.tmp
*.temp
*.bak
*.orig

# IDE and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Project-generated outputs
result/*
!result/Chapter02_local_*.png
pics/*
!pics/Chapter02_local_*.png

# Script-side benchmark outputs (results data, not source)
scripts/**/*_results.json

# Historical or local-only folders
old/
notebooks/version/

# Local secrets and environment overrides
.env
*.env
