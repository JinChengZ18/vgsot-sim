# Enforce LF line endings repo-wide (Windows-safe; prevents CRLF churn).
# Text files are auto-detected and normalized to LF in the repo and on checkout.
* text=auto eol=lf

# Windows-only scripts that must keep CRLF (none at present; kept defensively).
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary assets — never normalize or attempt to diff.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.docx binary
*.xlsx binary
*.pptx binary
*.zip  binary
